# ==============================================================
# Bokonzi — URL rewriting propre pour SEO
# ==============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ----------------------------------------------------------
    # 1) Ne pas reecrire les fichiers et dossiers existants
    # ----------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ----------------------------------------------------------
    # 2) Ne pas reecrire les zones techniques
    # ----------------------------------------------------------
    RewriteRule ^(api|admin|core|cache|logs|scraping|Class|src|pages|public|app|routes|config|docs)(/|$) - [L]

    # ----------------------------------------------------------
    # 3) 301 : URLs legacy /index.php?page=X -> /X
    #    (preserve les parametres supplementaires)
    # ----------------------------------------------------------
    RewriteCond %{THE_REQUEST} \s/+index\.php\?page=(accueil|athletes|recherche|clubs|villes|epreuves|comparer|tuto|espace|produits|concept|contact|solutions|tarifs|mentions-legales|confidentialite)\s [NC]
    RewriteRule ^index\.php$ /%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+index\.php\?page=(accueil|athletes|recherche|clubs|villes|epreuves|comparer|tuto|espace|produits|concept|contact|solutions|tarifs|mentions-legales|confidentialite)&([^\s]+)\s [NC]
    RewriteRule ^index\.php$ /%1?%2 [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+\?page=(accueil|athletes|recherche|clubs|villes|epreuves|comparer|tuto|espace|produits|concept|contact|solutions|tarifs|mentions-legales|confidentialite)\s [NC]
    RewriteRule ^$ /%1? [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+\?page=(accueil|athletes|recherche|clubs|villes|epreuves|comparer|tuto|espace|produits|concept|contact|solutions|tarifs|mentions-legales|confidentialite)&([^\s]+)\s [NC]
    RewriteRule ^$ /%1?%2 [R=301,L]

    # ----------------------------------------------------------
    # 4) Routes parametriques : /profil/123, /clubs/NomClub, etc.
    # ----------------------------------------------------------
    RewriteRule ^profil/([0-9]+)/?$ index.php?page=profil&id=$1 [L,QSA]
    RewriteRule ^clubs/([^/]+)/?$ index.php?page=clubs&open=$1 [L,QSA]
    RewriteRule ^villes/([^/]+)/?$ index.php?page=villes&open=$1 [L,QSA]
    RewriteRule ^epreuves/([^/]+)/?$ index.php?page=epreuves&nom=$1 [L,QSA]

    # ----------------------------------------------------------
    # 5) Pages principales : /accueil, /athletes, etc.
    # ----------------------------------------------------------
    RewriteRule ^(accueil|athletes|recherche|clubs|villes|epreuves|comparer|tuto|espace|produits|concept|contact|solutions|tarifs|mentions-legales|confidentialite)/?$ index.php?page=$1 [L,QSA]

    # ----------------------------------------------------------
    # 6) Racine / -> accueil (sans redirection visible)
    # ----------------------------------------------------------
    RewriteRule ^$ index.php?page=accueil [L,QSA]
</IfModule>

# ==============================================================
# Headers securite et cache
# ==============================================================
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Cache long pour les assets statiques
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>
